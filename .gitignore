# ---------------------------------------------------------------------------
# Build output
#
# Build-Reproduce.ps1 writes everything below into ./work next to itself.
# None of it is source: the checkouts are cloned, the dependencies downloaded
# and every binary re-generated by the build.
# ---------------------------------------------------------------------------
/work/

# The same artifacts for a build started directly in this directory.
/.obs-repro-owned.json
/.stages/
/build/
/custom-ffmpeg/
/downloads/
/local/
/logs/
/OBS-Studio-FDK-QSV/
/tools/atl/

# Upstream checkouts, plus the dependency archives unpacked into them.
/fdk-aac/
/ffmpeg/
/libvpl/
/obs-deps/
/obs-studio/

# ---------------------------------------------------------------------------
# Verification output
#
# Compare-Codecs.ps1 and Verify-Package.ps1 write their results next to
# themselves. Keep the sources in this directory (CMakeLists.txt, *.ps1, *.c).
# ---------------------------------------------------------------------------
/verification/stock-*.txt
/verification/custom-*.txt
/verification/*-options.txt
/verification/*-diff.json
/verification/*-decode.log
/verification/*-volume.log
/verification/standard-fdk.*
/verification/custom-fdk.*
/verification/build-tools.json
/verification/source-commits.json
/verification/obs-recording.log
/verification/build/

# ---------------------------------------------------------------------------
# Tooling noise
# ---------------------------------------------------------------------------
.vs/
Thumbs.db
desktop.ini
